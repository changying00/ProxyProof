# ProxyProof 配置示例
# 复制成 .env 后按需修改：cp .env.example .env
# .env 已被 .gitignore 忽略，可以放心写本机专属配置（含密码）

# ---------- 运行环境 ----------
# dev / test / prod；prod 下日志只输出 ERROR，并改用 gevent 跑 API
APP_ENV=dev
# dev 下默认 true
# APP_DEBUG=true
# prod 下的 WSGI 容器，可选 gevent / tornado / meinheld
# APP_PROD_METHOD=gevent

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 没有密码就留空
REDIS_PASSWORD=
REDIS_DB=0
# 连接串优先于上面四项，两种写法二选一：
# REDIS_CONNECTION_STRING=redis://:password@127.0.0.1:6379/0

# ---------- 探测目标（最重要的配置）----------
# 每个 key 对应一组目标，分数完全独立；API 用 ?key= 选择
# 默认用 Cloudflare 的连通性端点：204、0 字节，专为海量探测设计，不打扰任何站点
# 加自己的目标站时新开一个 key，不要改 default
PROBE_TARGETS={"default":[{"url":"http://cp.cloudflare.com/","min_len":0}]}
# 例：
# PROBE_TARGETS={"default":[{"url":"http://cp.cloudflare.com/","min_len":0}],"mysite":[{"url":"https://www.example.com/","min_len":5000}]}

# ---------- 探测参数 ----------
# 身份探针：一次请求同时得到 存活 / 出口 IP / 延迟，按顺序回退
PROBE_IDENTITY_URLS=["http://ip.3322.net/","http://myip.ipip.net/"]
# 本机出口 IP 会轮换，基线缓存多久（秒）
PROBE_BASELINE_TTL=600
# 裸 TCP 连接超时，决定"死代理"的成本，0.8 秒够用
PROBE_TCP_TIMEOUT=0.8
PROBE_TIMEOUT_IDENTITY=3
PROBE_TIMEOUT_TARGET=6
# 探测并发数，调高更快但更容易触发本机端口/带宽瓶颈
PROBE_CONCURRENCY=100
# 单批探测数量
PROBE_BATCH=200

# ---------- 池容量与调度 ----------
# 池子上限。不是越大越好：fresh 的天花板由「检测吞吐 × 可用率」决定
PROXY_NUMBER_MAX=3000
# 新代理入池初始分（满分 100 由评分公式算出）
PROXY_SCORE_INIT=10
# 新代理首次检测在 [0, N] 秒内打散，约等于 上限 / 检测吞吐
INTRODUCE_WINDOW=600
# 检测器每轮的时间预算（秒）
CYCLE_TESTER=20
# 抓取周期（秒）
CYCLE_GETTER=300
# 分发新鲜度闸门（秒）：超过这个年龄的代理不返回，宁可 503
# 想提高 precision 就调小（60），想要更大的池子就调大（180）
PROBE_MAX_AGE=120
# 爬虫请求超时
GET_TIMEOUT=10

# ---------- API ----------
# 只给本机用可改成 127.0.0.1
API_HOST=0.0.0.0
API_PORT=5555
API_THREADED=true
# 设置后请求需带 API-KEY 请求头；留空则不鉴权
API_KEY=

# ---------- 开关 ----------
ENABLE_GETTER=true
ENABLE_TESTER=true
ENABLE_SERVER=true

# ---------- 日志 ----------
ENABLE_LOG_FILE=true
ENABLE_LOG_RUNTIME_FILE=true
ENABLE_LOG_ERROR_FILE=true
LOG_DIR=logs
# LOG_RUNTIME_FILE=logs/runtime.log
# LOG_ERROR_FILE=logs/error.log
LOG_ROTATION=500MB
LOG_RETENTION=1 week

# ---------- 预留（尚未实现）----------
# IP 质量富化：计划在入池时和每 24 小时调用一次，写入 meta 的 risk / cc
# PROBE_ENRICH_URL=
# PROBE_ENRICH_TTL=86400
